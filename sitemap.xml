---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://autismogt.org/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ '/informa/' | absolute_url }}</loc>
    <lastmod>{% if site.posts.size > 0 %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {%- for e in site.posts %}
  <url>
    <loc>{{ e.url | absolute_url }}</loc>
    <lastmod>{{ e.last_modified_at | default: e.date | date_to_xmlschema }}</lastmod>
    <priority>0.6</priority>
  </url>
  {%- endfor %}
</urlset>
